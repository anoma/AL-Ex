				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Local checkout\n\nIf a compatible Gt4beam is already loaded, replace /path/to/AL-Ex below with your checkout path and load AL's #dev group. This skips the bridge dependency. You do not need both installation snippets."
			},
			{
				"__type" : "pharoSnippet",
